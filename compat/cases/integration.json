  },
  {
    "id": "history-load",
    "capability_ids": [
      "surface:history-format"
    ],
    "fixture_set": "pager",
    "mode": "pty",
    "argv": [
      "-X",
      "--no-keypad",
      "--no-paste",
      "-Ps@@READY@@",
      "-Pm@@READY@@",
      "-PM@@READY@@",
      "input.txt"
    ],
    "files": {
      "history": {
        "text": ".less-history-file:\n.search\n\"needle\n.shell\n.mark\nm a 1 0 input.txt\n"
      }
    },
    "env": {
      "LESSHISTFILE": "{ROOT}/history"
    },
    "events": [
      {
        "await": [
          "@@READY@@"
        ]
      },
      {
        "send": "/\u001bk\n",
        "await": [
          "@@READY@@",
          "(press RETURN)"
        ],
        "snapshot": true
      },
      {
        "send": "q"
      }
    ]
  }
